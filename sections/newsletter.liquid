{%- comment -%}
  Newsletter signup, modeled on Egmont Honey's "Join our hive today"
  section. Wired to Shopify's native customer/marketing list via the
  built-in `customer` form (creates or updates a Customer record with
  accepts_marketing true) — no separate email app required. Sits in the
  footer group, so it appears above the footer on every page.
{%- endcomment -%}

<section class="newsletter">
  <div class="newsletter__inner">
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}
      <p class="newsletter__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      {%- if form.posted_successfully? -%}
        <p class="newsletter__message newsletter__message--success">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field-row">
          <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">
            {{ 'sections.newsletter.email_label' | t }}
          </label>
          <input
            type="email"
            id="NewsletterEmail-{{ section.id }}"
            name="contact[email]"
            class="newsletter__input"
            placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
            autocomplete="email"
            required
          >
          <button type="submit" class="newsletter__submit">{{ 'sections.newsletter.submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <div class="newsletter__message newsletter__message--error">
            {%- for field in form.errors -%}
              <p>{{ form.errors.messages[field] }}</p>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Grove"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Be the first to hear about new harvests, limited releases, and stories from the grove."
    }
  ]
}
{% endschema %}
