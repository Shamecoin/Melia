{%- comment -%}
  Homepage hero carousel. This is the section the header goes transparent
  over — it must keep the `data-hero` attribute the header's scroll logic
  (assets/header.js) looks for.
{%- endcomment -%}

<section
  class="hero"
  data-hero
  data-hero-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="hero__viewport">
    <ul class="hero__track" data-hero-track role="list">
      {%- for block in section.blocks -%}
        <li
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="hero__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt=""
                class="hero__image"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {%- else -%}
              <div class="hero__placeholder" aria-hidden="true"></div>
            {%- endif -%}
            <div class="hero__scrim" aria-hidden="true"></div>
          </div>

          <div class="hero__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="hero__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="hero__subtext">{{ block.settings.subtext }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="hero__button">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="hero__arrow hero__arrow--prev" data-hero-prev aria-label="{{ 'sections.hero.previous_slide' | t }}">
      {% render 'icon-arrow-left' %}
    </button>
    <button type="button" class="hero__arrow hero__arrow--next" data-hero-next aria-label="{{ 'sections.hero.next_slide' | t }}">
      {% render 'icon-arrow-right' %}
    </button>

    <div class="hero__dots" role="tablist" data-hero-dots aria-label="{{ 'sections.hero.slide_selector' | t }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="hero__dot{% if forloop.first %} is-active{% endif %}"
          data-hero-dot="{{ forloop.index0 }}"
          role="tab"
          aria-label="{{ 'sections.hero.go_to_slide' | t: index: forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Full-bleed. Leave empty to show a placeholder until real photography is ready."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
