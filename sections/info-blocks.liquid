{%- comment -%}
  Stacked heading + body text blocks — a generic, reusable pattern for
  Q&A-style content sections (built for the "What is Melia?" page, Step 14,
  but not specific to it). Each block is independently editable/reorderable
  from the customizer.
{%- endcomment -%}

<section class="info-blocks">
  <div class="info-blocks__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="info-blocks__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="info-blocks__list">
        {%- for block in section.blocks -%}
          <div class="info-blocks__item" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="info-blocks__item-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="info-blocks__item-body rte">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Info blocks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to start directly with the first block."
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text",
          "default": "<p>Body text goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info blocks",
      "blocks": [
        { "type": "block" },
        { "type": "block" }
      ]
    }
  ]
}
{% endschema %}
