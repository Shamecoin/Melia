{%- comment -%}
  Collection grid page. Reuses snippets/product-grid.liquid as-is, so the
  card style matches the "Honey" tabbed section from Step 5 exactly.
{%- endcomment -%}

<section class="main-collection">
  <div class="main-collection__inner">
    <h1 class="main-collection__heading">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="main-collection__description rte">{{ collection.description }}</div>
    {%- endif -%}

    {%- render 'product-grid', collection: collection -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
