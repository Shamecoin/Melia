{%- comment -%}
  "Meet the Makers" teaser: left is a photo with overlaid heading text,
  right is a stack of maker preview blocks (name, description, image).
  The entire section is one link through to the full "Meet the Honey
  Makers" page — there's no other interactive element inside it, so
  wrapping the whole block in a single <a> is valid and keeps the teaser
  fully clickable.
{%- endcomment -%}

<a href="{{ section.settings.link | default: '/pages/meet-the-honey-makers' }}" class="makers-teaser">
  <div class="makers-teaser__inner">
    <div class="makers-teaser__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt=""
          class="makers-teaser__image"
          loading="lazy"
        >
      {%- else -%}
        <div class="makers-teaser__placeholder" aria-hidden="true"></div>
      {%- endif -%}
      <div class="makers-teaser__scrim" aria-hidden="true"></div>
      {%- if section.settings.heading != blank -%}
        <span class="makers-teaser__heading">{{ section.settings.heading }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="makers-teaser__list">
        {%- for block in section.blocks -%}
          <div class="makers-teaser__profile" {{ block.shopify_attributes }}>
            <div class="makers-teaser__profile-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 200 }}"
                  alt=""
                  class="makers-teaser__profile-image"
                  loading="lazy"
                >
              {%- else -%}
                <div class="makers-teaser__profile-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="makers-teaser__profile-text">
              {%- if block.settings.name != blank -%}
                <p class="makers-teaser__profile-name">{{ block.settings.name }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="makers-teaser__profile-description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</a>

{% schema %}
{
  "name": "Meet the Makers teaser",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left photo",
      "info": "Leave empty to show a placeholder until real photography is ready."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overlay heading",
      "default": "Meet the Makers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Defaults to the Meet the Honey Makers page when left blank."
    }
  ],
  "blocks": [
    {
      "type": "maker",
      "name": "Maker",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Leave empty to show a placeholder until real photography is ready."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maker name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "A short description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meet the Makers teaser",
      "blocks": [
        { "type": "maker" },
        { "type": "maker" },
        { "type": "maker" }
      ]
    }
  ]
}
{% endschema %}
