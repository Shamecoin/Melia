{%- comment -%}
  Site header. The Shop mega-menu is wired to real collections/products.
  Learn's mega-menu content and the mobile submenu content are still
  placeholders, wired up in a later step.
{%- endcomment -%}

<header
  class="site-header{% if section.settings.enable_transparent_header %} site-header--transparent-enabled{% endif %}"
  data-site-header
>
  <div class="site-header__inner">

    <div class="site-header__zone site-header__zone--left">
      <button
        type="button"
        class="site-header__hamburger"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls="MobileMenu"
      >
        <span class="site-header__hamburger-bar"></span>
        <span class="site-header__hamburger-bar"></span>
        <span class="site-header__hamburger-bar"></span>
        <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      </button>

      <nav class="site-header__nav" aria-label="{{ 'header.main_nav' | t }}">
        <ul class="site-header__nav-list" role="list">
          <li class="site-header__nav-item">
            <button
              type="button"
              class="site-header__nav-link"
              data-mega-menu-trigger="shop"
              aria-expanded="false"
              aria-controls="MegaMenu-shop"
            >
              {{ 'header.nav.shop' | t }}
            </button>
          </li>
          <li class="site-header__nav-item">
            <button
              type="button"
              class="site-header__nav-link"
              data-mega-menu-trigger="learn"
              aria-expanded="false"
              aria-controls="MegaMenu-learn"
            >
              {{ 'header.nav.learn' | t }}
            </button>
          </li>
        </ul>
      </nav>
    </div>

    <div class="site-header__zone site-header__zone--center">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if section.settings.logo -%}
          <img
            class="site-header__logo-image"
            src="{{ section.settings.logo | image_url: width: 480 }}"
            width="{{ section.settings.logo_width }}"
            height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio }}"
            alt="{{ shop.name }}"
            loading="eager"
          >
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name | default: 'Thermae Organics' }}</span>
        {%- endif -%}
        <span class="site-header__tagline">{{ 'header.tagline' | t }}</span>
      </a>
    </div>

    <div class="site-header__zone site-header__zone--right">
      {%- comment -%}
        Currency/region selector. Multi-currency (Shopify Markets) is not yet
        enabled on this store — this is a visual stub only, showing the UK
        market as the sole option. Once Markets is enabled, replace this
        block with the localization_form and a real currency/country list.
      {%- endcomment -%}
      <div class="site-header__currency" data-currency-selector>
        <button
          type="button"
          class="site-header__currency-trigger"
          data-currency-toggle
          aria-expanded="false"
          aria-controls="CurrencyPanel"
        >
          <span>{{ 'header.currency.current' | t }}</span>
          {% render 'icon-chevron' %}
        </button>
        <div class="site-header__currency-panel" id="CurrencyPanel" data-currency-panel hidden>
          <ul role="list">
            <li>
              <button type="button" class="site-header__currency-option is-active">
                {{ 'header.currency.uk' | t }}
              </button>
            </li>
          </ul>
        </div>
      </div>

      <a
        href="{{ routes.account_url }}"
        class="site-header__icon-link"
        data-icon="account"
        aria-label="{{ 'header.account' | t }}"
      >
        {% render 'icon-account' %}
      </a>

      <button
        type="button"
        class="site-header__icon-link"
        data-search-toggle
        aria-label="{{ 'header.search' | t }}"
        aria-expanded="false"
        aria-controls="SearchOverlay"
      >
        {% render 'icon-search' %}
      </button>

      <a
        href="{{ routes.cart_url }}"
        class="site-header__icon-link site-header__cart-link"
        aria-label="{{ 'header.cart' | t }}"
      >
        {% render 'icon-cart' %}
        <span
          class="site-header__cart-count"
          data-cart-count
          {% if cart.item_count == 0 %}hidden{% endif %}
        >{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="mega-menu" id="MegaMenu-shop" data-mega-menu="shop" hidden>
    <div class="mega-menu__inner mega-menu__inner--shop">
      <nav class="shop-menu" aria-label="{{ 'header.nav.shop' | t }}">
        <ul class="shop-menu__list" role="list">
          {%- render 'shop-menu-group', collection_handle: 'varietal-honeys', product_handles: 'chestnut-honey,forest-honey' -%}
          {%- render 'shop-menu-group', collection_handle: 'exclusive-limited-edition', product_handles: 'heather-and-ivy-honey' -%}
          {%- render 'shop-menu-group', collection_handle: 'exclusive-giftpacks' -%}
        </ul>
      </nav>
    </div>
  </div>

  <div class="mega-menu" id="MegaMenu-learn" data-mega-menu="learn" hidden>
    <div class="mega-menu__inner mega-menu__inner--learn">
      <div class="learn-menu">

        <div class="learn-menu__half learn-menu__half--links">
          <nav class="learn-menu__column learn-menu__column--links" aria-label="{{ 'header.mega_menu.learn.about_nav' | t }}">
            <ul class="learn-menu__list" role="list">
              {%- comment -%}
                About Us and Statement of Purpose are the same page — both
                links point at pages['about-us'], per the merge in Step 11.
              {%- endcomment -%}
              <li><a href="{{ pages['about-us'].url }}" class="learn-menu__link">{{ pages['about-us'].title | default: 'About Us' }}</a></li>
              <li><a href="{{ pages['about-us'].url }}" class="learn-menu__link">{{ 'header.mega_menu.learn.statement_caption' | t }}</a></li>
              <li><a href="{{ pages['meet-the-honey-makers'].url }}" class="learn-menu__link">{{ pages['meet-the-honey-makers'].title | default: 'Meet the Honey Makers' }}</a></li>
              <li><a href="{{ pages['articles'].url }}" class="learn-menu__link">{{ 'header.mega_menu.learn.articles_caption' | t }}</a></li>
              <li><a href="{{ pages['faq'].url }}" class="learn-menu__link">{{ pages['faq'].title | default: 'FAQ' }}</a></li>
            </ul>
          </nav>

          <div class="learn-menu__column learn-menu__column--honey">
            <div class="learn-menu__honey-heading">
              <span class="learn-menu__honey-image-wrap">
                {%- if section.settings.learn_column2_image != blank -%}
                  <img
                    src="{{ section.settings.learn_column2_image | image_url: width: 160 }}"
                    alt=""
                    class="learn-menu__honey-image"
                    width="56"
                    height="56"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="learn-menu__image-placeholder learn-menu__image-placeholder--small" aria-hidden="true"></span>
                {%- endif -%}
              </span>
              <span class="learn-menu__honey-title">{{ 'header.mega_menu.learn.honey_heading' | t }}</span>
            </div>
            <ul class="learn-menu__list" role="list">
              <li><a href="{{ pages['gathering'].url }}" class="learn-menu__link">{{ pages['gathering'].title | default: 'Gathering' }}</a></li>
              <li><a href="{{ pages['testing'].url }}" class="learn-menu__link">{{ pages['testing'].title | default: 'Testing' }}</a></li>
              <li><a href="{{ pages['recipes'].url }}" class="learn-menu__link">{{ pages['recipes'].title | default: 'Recipes' }}</a></li>
            </ul>
          </div>
        </div>

        <div class="learn-menu__half learn-menu__half--tiles">
          <a href="{{ pages['about-us'].url }}" class="learn-menu__column learn-menu__tile">
            {%- if section.settings.learn_column3_image != blank -%}
              <img
                src="{{ section.settings.learn_column3_image | image_url: width: 640 }}"
                alt=""
                class="learn-menu__tile-image"
                loading="lazy"
              >
            {%- else -%}
              <span class="learn-menu__image-placeholder" aria-hidden="true"></span>
            {%- endif -%}
            <span class="learn-menu__tile-scrim" aria-hidden="true"></span>
            <span class="learn-menu__tile-caption">{{ 'header.mega_menu.learn.statement_caption' | t }}</span>
          </a>

          {%- comment -%}
            "What is Melia?" has no dedicated page, so this tile also points at
            About Us / Statement of Purpose (the same merged page as the tile
            above) as the closest existing match.
          {%- endcomment -%}
          <a href="{{ pages['about-us'].url }}" class="learn-menu__column learn-menu__tile">
            {%- if section.settings.learn_column4_image != blank -%}
              <img
                src="{{ section.settings.learn_column4_image | image_url: width: 640 }}"
                alt=""
                class="learn-menu__tile-image"
                loading="lazy"
              >
            {%- else -%}
              <span class="learn-menu__image-placeholder" aria-hidden="true"></span>
            {%- endif -%}
            <span class="learn-menu__tile-scrim" aria-hidden="true"></span>
            <span class="learn-menu__tile-caption">{{ 'header.mega_menu.learn.melia_caption' | t }}</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</header>

<div class="site-header__backdrop" data-header-backdrop hidden></div>

<div class="search-overlay" id="SearchOverlay" data-search-overlay hidden>
  <div class="search-overlay__inner">
    <button
      type="button"
      class="search-overlay__close"
      data-search-close
      aria-label="{{ 'header.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
      <input
        type="search"
        name="q"
        class="search-overlay__input"
        placeholder="{{ 'header.search_placeholder' | t }}"
        autocomplete="off"
        data-search-input
      >
      <button type="submit" class="search-overlay__submit" aria-label="{{ 'header.search' | t }}">
        {% render 'icon-search' %}
      </button>
    </form>
  </div>
</div>

<div class="mobile-menu" id="MobileMenu" data-mobile-menu hidden>
  <div class="mobile-menu__header">
    <span class="mobile-menu__title">{{ 'header.menu' | t }}</span>
    <button
      type="button"
      class="mobile-menu__close"
      data-mobile-menu-close
      aria-label="{{ 'header.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>
  </div>

  <nav class="mobile-menu__nav" aria-label="{{ 'header.main_nav' | t }}">
    <ul role="list">
      <li>
        <button type="button" class="mobile-menu__link" data-mobile-submenu-trigger="shop">
          {{ 'header.nav.shop' | t }}
        </button>
      </li>
      <li>
        <button type="button" class="mobile-menu__link" data-mobile-submenu-trigger="learn">
          {{ 'header.nav.learn' | t }}
        </button>
      </li>
    </ul>
  </nav>

  <div class="mobile-menu__footer">
    <a href="{{ routes.account_url }}" class="mobile-menu__utility-link">
      {% render 'icon-account' %}
      <span>{{ 'header.account' | t }}</span>
    </a>
    <div class="mobile-menu__currency">
      <span>{{ 'header.currency.current' | t }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional. Falls back to the store name as text when no logo is set."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 260,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "label": "Transparent header over hero image",
      "info": "When enabled, the header has no background while it overlaps the homepage hero section, and gains a solid background once the page scrolls past it.",
      "default": true
    },
    {
      "type": "header",
      "content": "Learn menu images"
    },
    {
      "type": "image_picker",
      "id": "learn_column2_image",
      "label": "Column 2 image (\"Our Honey: What is Melia?\")"
    },
    {
      "type": "image_picker",
      "id": "learn_column3_image",
      "label": "Column 3 image (\"Statement of Purpose\" tile)"
    },
    {
      "type": "image_picker",
      "id": "learn_column4_image",
      "label": "Column 4 image (\"What is Melia?\" tile)"
    }
  ]
}
{% endschema %}
