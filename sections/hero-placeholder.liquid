{%- comment -%}
  TEMPORARY placeholder hero, used only so the header's transparent-over-hero
  scroll behavior has something real to key off of during this step. Replace
  with the actual homepage hero section in a later step — the header only
  cares that the element it's positioned over carries `data-hero`.
{%- endcomment -%}

<section class="hero-placeholder" data-hero>
  <div class="hero-placeholder__inner">
    <p class="hero-placeholder__eyebrow">{{ 'sections.hero_placeholder.eyebrow' | t }}</p>
    <h1 class="hero-placeholder__heading">{{ 'sections.hero_placeholder.heading' | t }}</h1>
  </div>
</section>

{% style %}
  .hero-placeholder {
    height: 100vh;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2rem;
    background: linear-gradient(180deg, rgba(37, 26, 16, 0.55), rgba(37, 26, 16, 0.7)),
      linear-gradient(135deg, var(--color-brown-mid), var(--color-ink));
    color: var(--color-cream);
  }

  .hero-placeholder__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.85;
  }

  .hero-placeholder__heading {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2rem, 5vw, 3.5rem);
    max-width: 30ch;
    margin-inline: auto;
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero (placeholder)",
  "settings": [],
  "presets": [
    {
      "name": "Hero (placeholder)"
    }
  ]
}
{% endschema %}
