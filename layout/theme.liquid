<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_cream }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {%- style -%}
      :root {
        --color-cream: {{ settings.color_cream }};
        --color-ink: {{ settings.color_ink }};
        --color-brown-mid: {{ settings.color_brown_mid }};
        --color-brown-light: {{ settings.color_brown_light }};
        --color-green: {{ settings.color_green }};
        --font-heading: 'Fraunces', {{ settings.font_heading.family }}, serif;
        --font-body: 'Instrument Sans', {{ settings.font_body.family }}, sans-serif;
      }
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'hero.css' | asset_url | stylesheet_tag }}
    {{ 'honey-tabs.css' | asset_url | stylesheet_tag }}
    {{ 'crafted-by-nature.css' | asset_url | stylesheet_tag }}
    {{ 'reviews.css' | asset_url | stylesheet_tag }}
    {{ 'image-with-text.css' | asset_url | stylesheet_tag }}
    {{ 'newsletter.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'founders.css' | asset_url | stylesheet_tag }}
    {{ 'makers-teaser.css' | asset_url | stylesheet_tag }}
    {{ 'maker-profiles.css' | asset_url | stylesheet_tag }}
    {{ 'accordion.css' | asset_url | stylesheet_tag }}
    {{ 'faq.css' | asset_url | stylesheet_tag }}
    {{ 'news-recipes.css' | asset_url | stylesheet_tag }}
    {{ 'article.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-{{ template.name }}{% if template.name == 'index' %} has-hero{% endif %}">
    <a class="visually-hidden skip-to-content-link" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {{ 'header.js' | asset_url | script_tag }}
    {{ 'hero-carousel.js' | asset_url | script_tag }}
    {{ 'honey-tabs.js' | asset_url | script_tag }}
    {{ 'accordion.js' | asset_url | script_tag }}
    {{ 'news-recipes.js' | asset_url | script_tag }}
  </body>
</html>
